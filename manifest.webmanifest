    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Shopping list", "url": "./#list", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
